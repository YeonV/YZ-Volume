<Window x:Class="YZ_Volume.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YZ-Volume" 
        Width="400" MaxHeight="500"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="Manual">

    <Border Background="#202020" CornerRadius="8" BorderBrush="#444" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,10,45,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="PresetComboBox" 
                          Grid.Column="0" 
                          SelectionChanged="PresetComboBox_SelectionChanged"/>

                <Button Grid.Column="1" 
                        Content="&#xE72C;" 
                        Style="{StaticResource TestIconButtonStyle}"
                        Background="Transparent"
                        Margin="5,0,0,0"
                        Click="RefreshPreset_Click"
                        ToolTip="Reset to Preset Values"/>
            </Grid>


            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15,0,15,40">
                    <!-- Panel for Windows Device Sliders -->
                    <StackPanel x:Name="DeviceListPanel" />

                    <!-- Separator between Windows and Matrix controls -->
                    <Separator x:Name="MatrixSeparator" 
                               Background="#444" 
                               Margin="0,10"
                               Visibility="Collapsed"/>

                    <!-- Master Slider - Independent and at the top of Matrix section -->
                    <Grid x:Name="MasterSliderGrid" Margin="0,0,0,15" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0" Style="{StaticResource MuteToggleButtonStyle}" VerticalAlignment="Center" x:Name="MasterMuteButton"/>
                        <TextBlock Grid.Column="1" Text="Master" Foreground="WhiteSmoke" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                        <Slider Grid.Column="2" Minimum="-60" Maximum="12" Value="0" Style="{StaticResource UltimateSliderStyle}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" x:Name="MasterVolumeSlider"/>
                        <Button Grid.Column="3" Content="-" Style="{StaticResource NudgeButtonStyle}" Margin="5,0,2,0" ToolTip="Nudge Master Gain -1 dB" x:Name="MasterNudgeDownButton"/>
                        <Button Grid.Column="4" Content="+" Style="{StaticResource NudgeButtonStyle}" Margin="2,0,0,0" ToolTip="Nudge Master Gain +1 dB" x:Name="MasterNudgeUpButton"/>
                    </Grid>

                    <Separator x:Name="MasterSeparator" 
                               Background="#444" 
                               Margin="0,0,0,10"
                               Visibility="{Binding Visibility, ElementName=MasterSliderGrid}"/>

                    <!-- Panel for individual Matrix Sliders -->
                    <StackPanel x:Name="MatrixControlsPanel" />
                </StackPanel>
            </ScrollViewer>

            <Button Style="{StaticResource SettingsIconButtonStyle}" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,5,7"
                    Click="SettingsButton_Click" />
        </Grid>
    </Border>
</Window>