<Window x:Class="YZ_Volume.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YZ-Volume Settings" Height="750" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        Icon="icon.ico"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">

    <Border Background="#202020" CornerRadius="8" BorderBrush="#444" BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- Main content area -->
                <RowDefinition Height="Auto" />
                <!-- Fixed button bar at the bottom -->
            </Grid.RowDefinitions>

            <!-- ### NEW TWO-COLUMN LAYOUT ### -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Left Column (Windows) -->
                    <ColumnDefinition Width="15" />
                    <!-- Gutter/Separator -->
                    <ColumnDefinition Width="*" />
                    <!-- Right Column (VBAN) -->
                </Grid.ColumnDefinitions>

                <!-- === LEFT COLUMN: WINDOWS SETTINGS === -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Title -->
                        <RowDefinition Height="Auto"/>
                        <!-- Auto-Select Section -->
                        <RowDefinition Height="Auto"/>
                        <!-- Sub-Title -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Sub-Title Description -->
                        <RowDefinition Height="*"   />
                        <!-- SCROLLING CONTENT -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Windows Integration" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <WrapPanel Grid.Row="1" Margin="0,1,0,5">
                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Click="OpenSoundSettings_Click"
                                Height="27"
                                Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <!--TextBlock Text="Control Panel"/-->
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Click="OpenVolumeMixer_Click"
                                Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <!--TextBlock Text="Mixer1"/-->
                            </StackPanel>
                        </Button>

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="Gray" />


                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Click="OpenMainSoundSettings_Click"
                                Margin="5,0,5,0">
                            <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <!--TextBlock Text="Sound1"/-->
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Click="OpenAllSoundDevices_Click"
                                Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <!--TextBlock Text="Sound2"/-->
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Click="OpenAppVolumeMixer_Click"
                                Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <!--TextBlock Text="Mixer2"/-->
                            </StackPanel>
                        </Button>
                        
                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Click="OpenVolumeFlyout_Click"
                                Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal" Margin="10,0,10,0">
                                <TextBlock Text="&#xE995;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <!--TextBlock Text="Volume"/-->
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Grid.Row="2" Text="Access different sound settings of windows" FontSize="12" Margin="5,5,0,15" Foreground="Gray" />
                    <Border Grid.Row="3" BorderBrush="#444" BorderThickness="0,1,0,1" Padding="0,15,0,15" Margin="0,0,0,15">
                        <StackPanel>
                            <CheckBox x:Name="AutoSelectDeviceCheckBox" Content="Auto-Select Default Playback Device on Startup" Click="AutoSelectDeviceCheckBox_Click"/>
                            <ComboBox x:Name="DefaultDeviceComboBox" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="4" Text="Audio Devices" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Grid.Row="5" Text="Select which sliders to show and customize names" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SettingsDeviceListPanel"/>
                    </ScrollViewer>
                </Grid>

                <!-- === GUTTER === -->
                <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="Transparent" />

                <!-- === RIGHT COLUMN: VBAN SETTINGS === -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="VB-Audio Matrix Integration" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- VBAN Connection Section -->
                            <Border BorderBrush="#444" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- VBAN Toggle -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Sync Button -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Spacer -->
                                            <ColumnDefinition Width="40"/>
                                            <!-- IP Label -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Port Label -->
                                            <ColumnDefinition Width="90"/>
                                            <!-- Port TextBox -->
                                            <ColumnDefinition Width="60"/>
                                            <!-- Show Console Toggle -->
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" x:Name="VbanToggleButton" Content="VBAN" Width="85" Style="{StaticResource PrimaryToggleButtonStyle}"/>

                                        <Button Grid.Column="1" x:Name="SyncButton" Click="SyncPresets_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="5,0,0,0" Width="60" ToolTip="Silently sync all presets from the live Matrix state">
                                            <Grid>
                                                <TextBlock x:Name="SyncButtonText" Text="Sync" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SyncButtonSpinner" Text="&#xE895;" FontFamily="Segoe Fluent Icons" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform/>
                                                    </TextBlock.RenderTransform>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <Trigger Property="Visibility" Value="Visible">
                                                                    <Trigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                             From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    
                                        <ToggleButton Grid.Column="2" x:Name="ShowConsoleToggleButton" 
                                          Content="&#xE713;" 
                                          Style="{StaticResource IconToggleButtonStyle}" 
                                          Margin="0,0,0,0" 
                                          ToolTip="Show/Hide VBAN Console"
                                          Width="40"
                                          Visibility="Collapsed"/>

                                        <TextBlock Grid.Column="4" Text="IP:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,5,0"/>
                                        <TextBox x:Name="VbanIpTextBox" Grid.Column="5" Width="90"/>
                                        <TextBox x:Name="VbanPortTextBox" Grid.Column="6" Width="60" />

                                    </Grid>
                                    <StackPanel x:Name="VbanStatusPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Ellipse x:Name="VbanStatusIndicator" Width="11" Height="11" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                        <TextBlock x:Name="VbanStatusTextBlock" Text="Status: Unknown" TextWrapping="Wrap" Foreground="Gray" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>


                            <Border x:Name="AutoSelectPresetBorder" BorderBrush="#444" BorderThickness="0,0,0,1" Padding="0,15,0,15" Margin="0,0,0,15">
                                <StackPanel>
                                    <CheckBox x:Name="AutoSelectPresetCheckBox" Content="Auto-Select Preset on Startup" Click="AutoSelectPresetCheckBox_Click"/>
                                    <ComboBox x:Name="AutoSelectPresetComboBox" Margin="0,10,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- VBAN Test & Management Section -->
                            <Border BorderBrush="#444" BorderThickness="0,0,0,1" Padding="0,0,0,10" x:Name="VbanTestPanel">
                                <StackPanel Margin="0,15,0,0">
                                    <!-- ### THIS IS THE PRESET MANAGER SECTION THAT WAS MISSING ### -->
                                    <TextBlock Text="Preset Manager" FontWeight="Bold" Margin="0,20,0,10"/>
                                    <StackPanel x:Name="PresetManagerPanel"/>
                                    <Button Content="Import Preset from XML..." Click="ImportPreset_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,40" Height="30" />

                                    <Grid>
                                        <TextBlock Text="VBAN Console" FontWeight="Bold" Margin="0,0,0,10" VerticalAlignment="Center"/>
                                        <Button Content="&#xE74D;" 
                                    Style="{StaticResource TestIconButtonStyle}" 
                                    HorizontalAlignment="Right" 
                                    Click="ClearHistory_Click" 
                                    Width="50"
                                    Height="25"
                                    ToolTip="Clear History"/>
                                    </Grid>
                                    <ListBox x:Name="HistoryListBox" Height="150" Margin="0,0,0,5" Background="#000000"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CustomCommandTextBox" Grid.Column="0" PreviewKeyDown="CustomCommandTextBox_PreviewKeyDown" Background="#000000"/>
                                        <Button Grid.Column="1" Content="&#xE724;" Click="SendCustomCommand_Click" Style="{StaticResource TestIconButtonStyle}" Margin="5,0,0,0" Width="50" ToolTip="Send Command"/>
                                    </Grid>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="Version" Tag="Command.Version = ?" Click="PaletteButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,5" Height="25" Width="100" />
                                        <Button Content="Engine" Tag="Command.Engine = ?" Click="PaletteButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,5" Height="25" Width="100" />
                                        <Button Content="Preset Name" Tag="PresetPatch[1].Name = ?" Click="PaletteButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,5" Height="25" Width="100" />
                                    </WrapPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="Run Diagnostics" Click="QueryAll_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,5,0"  Height="25" ToolTip="Run a full diagnostic scan and log to console"/>
                                        <Button Grid.Column="1" Content="Import Live State" Click="GetLiveState_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="5,0,5,0"  Height="25" ToolTip="Import the current grid as a new preset"/>

                                        <!-- ### NEW BUTTON ### -->
                                        <Button Grid.Column="2" Content="Sync Presets" Click="SyncPresets_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="5,0,0,0"  Height="25" ToolTip="Silently sync all presets from the live Matrix state"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="PresetConfigBorder" BorderBrush="#444" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Presets" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock Text="Select which presets to show and customize names" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="PresetConfigPanel"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#444" BorderThickness="0,0,0,0" Margin="0,0,0,0" Padding="0,0,0,0" x:Name="MatrixConfigBorder">
                                
                                <StackPanel>
                                    <TextBlock Text="Channels" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock Text="Select which channel sliders to show and customize names" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"/>
                                    <StackPanel x:Name="MatrixSliderConfigPanel"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>

            <Grid x:Name="LoadingSpinner" Grid.RowSpan="2" Background="#202020">
                <TextBlock Text="&#xE895;" 
                           FontFamily="Segoe Fluent Icons"
                           FontSize="40"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="WhiteSmoke"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>
            <!-- BUTTON BAR -->
            <Grid Grid.Row="1" Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Height="30" Width="85" Click="SaveButton_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="Cancel" Height="30" Width="85" Margin="5,0,0,0" Click="CancelButton_Click" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>